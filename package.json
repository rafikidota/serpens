{
  "name": "@rafikidota/serpens",
  "version": "1.12.0",
  "description": "Sometimes, the best way to solve your own problems is to help someone else.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafikidota/serpens.git"
  },
  "author": "rafiki <71207415+rafikidota@users.noreply.github.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prepare": "husky",
    "prebuild": "rimraf -rf dist",
    "build": "tsc -p tsconfig.json",
    "lint": "npx eslint --debug . --fix",
    "format": "prettier --write \"**/*.ts\"",
    "prepublishOnly": "npm run lint && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.35.0",
    "@types/node": "24.3.1",
    "@typescript-eslint/eslint-plugin": "8.43.0",
    "@typescript-eslint/parser": "8.43.0",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.4",
    "globals": "16.3.0",
    "husky": "9.1.7",
    "lint-staged": "16.1.6",
    "prettier": "3.6.2",
    "rimraf": "6.0.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typeorm": "0.3.26",
    "typescript": "5.9.2",
    "typescript-eslint": "8.43.0",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "**/*.{ts,json}": [
      "prettier --write",
      "eslint"
    ]
  },
  "keywords": [
    "typeorm",
    "naming strategy",
    "database",
    "backend",
    "api"
  ]
}
