{
  "name": "@rafikidota/serpens",
  "version": "2.3.0",
  "description": "Sometimes, the best way to solve your own problems is to help someone else.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafikidota/serpens.git"
  },
  "author": "rafiki <71207415+rafikidota@users.noreply.github.com>",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "npx eslint --debug . --fix",
    "lint:check": "npx eslint .",
    "format": "prettier --write \"**/*.ts\"",
    "prepublishOnly": "npm run typecheck && npm run lint:check && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-one-line-import": "1.0.1",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.8.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.2.0",
    "prettier": "3.9.6",
    "tsdown": "0.22.14",
    "typeorm": "1.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "typeorm": "^1.1.0"
  },
  "keywords": [
    "typeorm",
    "naming strategy",
    "database",
    "backend",
    "api"
  ],
  "lint-staged": {
    "**/*.{ts,json}": [
      "prettier --write",
      "eslint"
    ]
  }
}
